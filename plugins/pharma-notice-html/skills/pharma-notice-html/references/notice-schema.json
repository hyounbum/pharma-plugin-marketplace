{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/notice-schema.json",
  "title": "Pharmaceutical Notice Draft",
  "description": "제약사 공지 이미지 판독, 사용자 수정, 승인 및 산출물 생성에 사용하는 데이터 계약",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "noticeId",
    "sourceImages",
    "companies",
    "approvalStatus"
  ],
  "properties": {
    "noticeId": {
      "type": "string",
      "minLength": 1,
      "description": "공지 작업 식별자"
    },
    "sourceImages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceImage"
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/company"
      }
    },
    "approvalStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED"
      ],
      "default": "PENDING",
      "description": "PENDING은 검토/수정 중, APPROVED는 사용자가 현재 초안을 승인한 상태"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "수정·제외·재분석 때 증가하는 낙관적 잠금 버전"
    },
    "approvedRevision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "default": null
    },
    "approvedContentHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$",
      "default": null,
      "description": "승인된 정규화 데이터의 SHA-256. HTML/PDF 동일성 검증에 사용"
    }
  },
  "$defs": {
    "sourceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceImageIndex",
        "fileRef"
      ],
      "properties": {
        "sourceImageIndex": {
          "type": "integer",
          "minimum": 1
        },
        "fileRef": {
          "type": "string",
          "minLength": 1,
          "description": "ChatGPT/MCP가 전달한 파일 참조. 실제 형식은 [확인 필요]"
        },
        "fileName": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$",
          "default": null
        },
        "duplicateOfImageIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "default": null
        },
        "readability": {
          "type": "string",
          "enum": [
            "READABLE",
            "PARTIAL",
            "UNREADABLE"
          ],
          "default": "READABLE"
        },
        "analysisStatus": {
          "type": "string",
          "enum": [
            "PENDING",
            "ANALYZED",
            "REUPLOAD_REQUIRED",
            "MANUAL_INPUT_REQUIRED"
          ],
          "default": "PENDING"
        }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companyId",
        "companyName",
        "items"
      ],
      "properties": {
        "companyId": {
          "type": "string",
          "minLength": 1,
          "description": "내부 안정 식별자"
        },
        "companyName": {
          "type": [
            "string",
            "null"
          ],
          "description": "이미지에 회사명이 없으면 null. 화면/문서에서는 '확인 중'으로 표시"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/noticeItem"
          }
        }
      }
    },
    "noticeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "category",
        "productName",
        "sourceImageIndex",
        "userEdited",
        "excluded"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "description": "도구 호출 간 항목 식별용 내부 ID"
        },
        "category": {
          "type": "string",
          "enum": [
            "품절",
            "입고",
            "신제품",
            "약가변동",
            "수수료변동",
            "생산중단",
            "공급중단",
            "정산중단",
            "신규금지",
            "판매중단",
            "일부규격품절",
            "입고미정",
            "기타"
          ]
        },
        "productName": {
          "type": [
            "string",
            "null"
          ],
          "description": "제품명 및 함량. 이미지에 없거나 판독 불가하면 null 허용"
        },
        "ingredient": {
          "type": [
            "string",
            "null"
          ],
          "description": "성분명. 미표기/판독 불가 시 null 허용"
        },
        "dosage": {
          "type": [
            "string",
            "null"
          ],
          "description": "성분량 또는 함량. 제품명에 포함되어도 별도 판독 가능할 때만 기록"
        },
        "insuranceCode": {
          "type": [
            "string",
            "null"
          ],
          "description": "보험코드. 앞자리 0 보존을 위해 문자열 사용"
        },
        "price": {
          "type": [
            "string",
            "null"
          ],
          "description": "약가와 단위를 이미지 표기 그대로 보존"
        },
        "previousRate": {
          "type": [
            "string",
            "null"
          ],
          "description": "기존 수수료율"
        },
        "newRate": {
          "type": [
            "string",
            "null"
          ],
          "description": "적용 후 수수료율. 계산 가능할 때 previousRate와 changeRate로 산출"
        },
        "changeRate": {
          "type": [
            "string",
            "null"
          ],
          "description": "변동 퍼센트. 인상/인하 부호 또는 원문 표현 보존"
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "description": "입고 예정, 품절, 생산중단 등 이미지의 상태 표현"
        },
        "effectiveDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "적용일/입고일/품절일 등 원문 날짜 표현. 강제 날짜 정규화 금지"
        },
        "settlementPeriod": {
          "type": [
            "string",
            "null"
          ],
          "description": "정산 적용·종료 기간 또는 처방분 기준 기간"
        },
        "remark": {
          "type": [
            "string",
            "null"
          ],
          "description": "비고. 이미지에 있는 추가 설명만 기록"
        },
        "sourceImageIndex": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "default": null,
          "description": "현재 GPT 지침에 점수 산정 규칙이 없어 기본 null. 산정 방식은 [확인 필요]"
        },
        "userEdited": {
          "type": "boolean",
          "default": false
        },
        "excluded": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}