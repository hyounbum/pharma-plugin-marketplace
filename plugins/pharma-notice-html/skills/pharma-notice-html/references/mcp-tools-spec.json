{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "specVersion": "1.0.0",
  "title": "제약사 공지 MCP 도구 명세",
  "principles": [
    "모든 입력과 출력은 구조화 JSON을 우선한다.",
    "외부 웹 검색 또는 외부 사실 보완을 수행하지 않는다.",
    "최종 HTML/PDF는 승인된 revision과 approvedContentHash에만 결합한다.",
    "수정·제외·승인·생성 도구는 expectedRevision과 idempotencyKey를 사용한다.",
    "도구 결과의 안정 식별자와 구조화 결과를 다음 호출에 재사용한다."
  ],
  "states": [
    "IMAGE_UPLOADING",
    "UPLOAD_COMPLETE",
    "IMAGE_ANALYSIS",
    "REVIEW_DRAFT",
    "USER_EDITING",
    "APPROVED",
    "HTML_GENERATING",
    "HTML_READY",
    "PDF_GENERATING",
    "COMPLETED",
    "ERROR_REANALYSIS"
  ],
  "commonErrorSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "code",
      "message",
      "retryable"
    ],
    "properties": {
      "code": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "retryable": {
        "type": "boolean"
      },
      "details": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    }
  },
  "tools": [
    {
      "name": "analyze_notice_images",
      "title": "제약사 공지 이미지 분석",
      "description": "업로드가 완료된 이미지 묶음을 업로드 순서대로 판독하고 중복·연속 페이지를 통합하여 구조화된 초안을 만든다. 이미지와 사용자 입력 외의 외부 사실을 사용하지 않는다.",
      "callWhen": [
        "사용자가 '업로드 완료', '사진 끝', '전부 올림' 등 완료 의사를 명시했다.",
        "sourceImages가 1개 이상이며 현재 상태가 UPLOAD_COMPLETE이다.",
        "reset_notice_analysis 후 같은 이미지 또는 재업로드 이미지로 재분석한다."
      ],
      "doNotCallWhen": [
        "이미지 업로드가 아직 진행 중이다.",
        "사용자가 단순히 중간 분석 결과를 요구했으나 완료 의사를 밝히지 않았다.",
        "현재 초안이 승인된 상태이며 reset_notice_analysis가 선행되지 않았다.",
        "외부 웹 검색으로 누락 정보를 보완하려는 경우."
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "noticeId",
          "sourceImages",
          "uploadComplete",
          "idempotencyKey"
        ],
        "properties": {
          "noticeId": {
            "type": "string",
            "minLength": 1
          },
          "sourceImages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceImageIndex",
                "fileRef"
              ],
              "properties": {
                "sourceImageIndex": {
                  "type": "integer",
                  "minimum": 1
                },
                "fileRef": {
                  "type": "string",
                  "minLength": 1
                },
                "fileName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "uploadComplete": {
            "const": true
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8
          },
          "analysisMode": {
            "type": "string",
            "enum": [
              "INITIAL",
              "REANALYSIS"
            ],
            "default": "INITIAL"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "noticeId",
          "state",
          "revision",
          "requestId",
          "warnings",
          "notice",
          "summary"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "noticeId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "IMAGE_UPLOADING",
              "UPLOAD_COMPLETE",
              "IMAGE_ANALYSIS",
              "REVIEW_DRAFT",
              "USER_EDITING",
              "APPROVED",
              "HTML_GENERATING",
              "HTML_READY",
              "PDF_GENERATING",
              "COMPLETED",
              "ERROR_REANALYSIS"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "requestId": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notice": {
            "$ref": "notice-schema.json"
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "totalImages",
              "analyzedNotices",
              "reuploadRequiredImageIndexes",
              "manualInputRequiredImageIndexes",
              "duplicateImageIndexes"
            ],
            "properties": {
              "totalImages": {
                "type": "integer",
                "minimum": 1
              },
              "analyzedNotices": {
                "type": "integer",
                "minimum": 0
              },
              "reuploadRequiredImageIndexes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "manualInputRequiredImageIndexes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "duplicateImageIndexes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "errorCodes": [
        "UPLOAD_NOT_COMPLETE",
        "NO_SOURCE_IMAGES",
        "SCHEMA_VALIDATION_FAILED",
        "IMAGE_FILE_UNAVAILABLE",
        "ANALYSIS_FAILED",
        "INVALID_STATE",
        "IDEMPOTENCY_CONFLICT"
      ],
      "userConfirmation": {
        "required": true,
        "condition": "사용자의 업로드 완료 의사가 명시되어야 한다. 별도 재확인 대화는 필요하지 않다."
      },
      "callOrder": {
        "before": [
          "이미지 수집 및 번호 부여"
        ],
        "after": [
          "get_notice_draft"
        ],
        "reanalysis": [
          "reset_notice_analysis",
          "analyze_notice_images",
          "get_notice_draft"
        ]
      },
      "idempotency": {
        "key": "noticeId + ordered(sourceImage.sha256|fileRef) + analysisMode",
        "behavior": "같은 키와 같은 입력이면 기존 분석 결과를 반환한다. 같은 키에 다른 입력이면 IDEMPOTENCY_CONFLICT."
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_notice_draft",
      "title": "공지 초안 조회",
      "description": "현재 구조화 초안, 수정 버전, 제외 상태, 승인 상태와 재업로드 필요 항목을 조회한다.",
      "callWhen": [
        "이미지 분석 직후 전체 확인 목록을 만들 때.",
        "수정·제외·승인 전에 최신 revision과 항목 ID를 확인할 때.",
        "HTML/PDF 생성 전 승인 데이터 해시를 검증할 때."
      ],
      "doNotCallWhen": [
        "아직 분석 결과가 없고 상태가 IMAGE_UPLOADING 또는 UPLOAD_COMPLETE인 경우 초안 조회 목적으로 호출하지 않는다."
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "noticeId"
        ],
        "properties": {
          "noticeId": {
            "type": "string",
            "minLength": 1
          },
          "includeExcluded": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "noticeId",
          "state",
          "revision",
          "requestId",
          "warnings",
          "notice",
          "unresolved"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "noticeId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "IMAGE_UPLOADING",
              "UPLOAD_COMPLETE",
              "IMAGE_ANALYSIS",
              "REVIEW_DRAFT",
              "USER_EDITING",
              "APPROVED",
              "HTML_GENERATING",
              "HTML_READY",
              "PDF_GENERATING",
              "COMPLETED",
              "ERROR_REANALYSIS"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "requestId": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notice": {
            "$ref": "notice-schema.json"
          },
          "unresolved": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conflicts",
              "reuploadRequiredImageIndexes",
              "manualInputRequiredImageIndexes"
            ],
            "properties": {
              "conflicts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reuploadRequiredImageIndexes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "manualInputRequiredImageIndexes": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "errorCodes": [
        "NOTICE_NOT_FOUND",
        "DRAFT_NOT_AVAILABLE",
        "SCHEMA_VALIDATION_FAILED"
      ],
      "userConfirmation": {
        "required": false,
        "condition": "읽기 전용 조회"
      },
      "callOrder": {
        "before": [
          "analyze_notice_images"
        ],
        "after": [
          "update_notice_items",
          "exclude_notice_items",
          "approve_notice",
          "render_notice_preview"
        ]
      },
      "idempotency": {
        "key": "없음",
        "behavior": "읽기 전용이며 동일 revision에서 동일 결과를 반환한다."
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "update_notice_items",
      "title": "공지 항목 수정",
      "description": "사용자가 명시적으로 수정한 필드만 현재 초안에 반영하고 전체 초안을 다시 통합·중복·충돌 점검한다.",
      "callWhen": [
        "사용자가 분석 결과의 회사명, 제품명 및 함량, 성분명/성분량, 보험코드, 약가, 수수료, 날짜, 상태, 비고 등을 수정했다.",
        "수기 입력 양식으로 보완값을 제공했다."
      ],
      "doNotCallWhen": [
        "사용자 수정값이 없는데 모델이 추정값을 채우려는 경우.",
        "승인 완료 후 reset_notice_analysis 없이 내용을 바꾸려는 경우.",
        "항목 제외만 수행하는 경우에는 exclude_notice_items를 사용한다."
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "noticeId",
          "expectedRevision",
          "updates",
          "idempotencyKey"
        ],
        "properties": {
          "noticeId": {
            "type": "string",
            "minLength": 1
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "updates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemId",
                "patch"
              ],
              "properties": {
                "itemId": {
                  "type": "string",
                  "minLength": 1
                },
                "patch": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "companyName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "productName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ingredient": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "dosage": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "insuranceCode": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "price": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "previousRate": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "newRate": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "changeRate": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "status": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "effectiveDate": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "settlementPeriod": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "remark": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "품절",
                        "입고",
                        "신제품",
                        "약가변동",
                        "수수료변동",
                        "생산중단",
                        "공급중단",
                        "정산중단",
                        "신규금지",
                        "판매중단",
                        "일부규격품절",
                        "입고미정",
                        "기타"
                      ]
                    }
                  }
                }
              }
            }
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "noticeId",
          "state",
          "revision",
          "requestId",
          "warnings",
          "notice",
          "changedItemIds",
          "conflicts"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "noticeId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "IMAGE_UPLOADING",
              "UPLOAD_COMPLETE",
              "IMAGE_ANALYSIS",
              "REVIEW_DRAFT",
              "USER_EDITING",
              "APPROVED",
              "HTML_GENERATING",
              "HTML_READY",
              "PDF_GENERATING",
              "COMPLETED",
              "ERROR_REANALYSIS"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "requestId": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notice": {
            "$ref": "notice-schema.json"
          },
          "changedItemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "errorCodes": [
        "NOTICE_NOT_FOUND",
        "ITEM_NOT_FOUND",
        "VERSION_CONFLICT",
        "INVALID_STATE",
        "SCHEMA_VALIDATION_FAILED",
        "INVALID_RATE_CALCULATION",
        "IDEMPOTENCY_CONFLICT"
      ],
      "userConfirmation": {
        "required": false,
        "condition": "사용자가 제출한 저장 동작 자체가 수정 의사 확인이다. 서버는 제출되지 않은 필드를 바꾸지 않는다."
      },
      "callOrder": {
        "before": [
          "get_notice_draft"
        ],
        "after": [
          "get_notice_draft",
          "추가 update_notice_items 또는 approve_notice"
        ]
      },
      "idempotency": {
        "key": "noticeId + expectedRevision + canonical(updates)",
        "behavior": "같은 요청은 한 번만 revision을 증가시킨다. 재전송 시 최초 결과를 반환한다."
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "exclude_notice_items",
      "title": "공지 항목 제외",
      "description": "사용자가 제외를 요청한 항목의 excluded 상태를 변경한다. 제외된 항목은 미리보기와 최종 HTML/PDF에서 제거한다.",
      "callWhen": [
        "사용자가 특정 항목 제외 체크를 저장했다.",
        "이전에 제외한 항목을 명시적으로 복원했다."
      ],
      "doNotCallWhen": [
        "모델이 중복으로 추정했지만 사용자 확인 없이 항목을 제외하려는 경우.",
        "승인 완료 후 reset_notice_analysis 없이 제외 상태를 바꾸려는 경우."
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "noticeId",
          "expectedRevision",
          "itemIds",
          "excluded",
          "idempotencyKey"
        ],
        "properties": {
          "noticeId": {
            "type": "string",
            "minLength": 1
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "itemIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "excluded": {
            "type": "boolean"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "noticeId",
          "state",
          "revision",
          "requestId",
          "warnings",
          "notice",
          "changedItemIds",
          "excludedItemIds"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "noticeId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "IMAGE_UPLOADING",
              "UPLOAD_COMPLETE",
              "IMAGE_ANALYSIS",
              "REVIEW_DRAFT",
              "USER_EDITING",
              "APPROVED",
              "HTML_GENERATING",
              "HTML_READY",
              "PDF_GENERATING",
              "COMPLETED",
              "ERROR_REANALYSIS"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "requestId": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notice": {
            "$ref": "notice-schema.json"
          },
          "changedItemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludedItemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "errorCodes": [
        "NOTICE_NOT_FOUND",
        "ITEM_NOT_FOUND",
        "VERSION_CONFLICT",
        "INVALID_STATE",
        "IDEMPOTENCY_CONFLICT"
      ],
      "userConfirmation": {
        "required": true,
        "condition": "사용자가 체크박스 또는 명시적 제외/복원 요청을 제출해야 한다. 전체 항목 제외 정책은 [확인 필요]."
      },
      "callOrder": {
        "before": [
          "get_notice_draft"
        ],
        "after": [
          "get_notice_draft",
          "approve_notice"
        ]
      },
      "idempotency": {
        "key": "noticeId + expectedRevision + sorted(itemIds) + excluded",
        "behavior": "동일 제외 상태 재적용은 no-op으로 처리하고 revision을 중복 증가시키지 않는다."
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "approve_notice",
      "title": "공지 초안 승인",
      "description": "사용자가 '그대로', '수정 없음', '이대로', '바로 생성' 또는 동등한 명시적 승인을 했을 때 현재 revision과 내용 해시를 고정한다.",
      "callWhen": [
        "사용자가 현재 전체 초안을 명시적으로 승인했다.",
        "수정·수기 보완 후 다시 제시된 전체 목록을 승인했다."
      ],
      "doNotCallWhen": [
        "사용자가 일부 항목만 확인했거나 승인 문구가 불명확하다.",
        "재업로드/수기 입력 필요 이미지 또는 충돌이 해결되지 않았다.",
        "최신 revision을 다시 조회하지 않았다."
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "noticeId",
          "expectedRevision",
          "approvalAction",
          "approvalContentHash",
          "userConfirmed",
          "idempotencyKey"
        ],
        "properties": {
          "noticeId": {
            "type": "string",
            "minLength": 1
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "approvalAction": {
            "type": "string",
            "enum": [
              "AS_IS",
              "AFTER_EDITS"
            ]
          },
          "approvalContentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "userConfirmed": {
            "const": true
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "noticeId",
          "state",
          "revision",
          "requestId",
          "warnings",
          "approval"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "noticeId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "IMAGE_UPLOADING",
              "UPLOAD_COMPLETE",
              "IMAGE_ANALYSIS",
              "REVIEW_DRAFT",
              "USER_EDITING",
              "APPROVED",
              "HTML_GENERATING",
              "HTML_READY",
              "PDF_GENERATING",
              "COMPLETED",
              "ERROR_REANALYSIS"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "requestId": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approvalStatus",
              "approvedRevision",
              "approvedContentHash"
            ],
            "properties": {
              "approvalStatus": {
                "const": "APPROVED"
              },
              "approvedRevision": {
                "type": "integer",
                "minimum": 0
              },
              "approvedContentHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      },
      "errorCodes": [
        "NOTICE_NOT_FOUND",
        "VERSION_CONFLICT",
        "APPROVAL_HASH_MISMATCH",
        "UNRESOLVED_REQUIRED_INPUT",
        "CONFLICT_UNRESOLVED",
        "INVALID_STATE",
        "IDEMPOTENCY_CONFLICT"
      ],
      "userConfirmation": {
        "required": true,
        "condition": "현재 전체 초안에 대한 사용자의 명시적 승인"
      },
      "callOrder": {
        "before": [
          "get_notice_draft"
        ],
        "after": [
          "generate_notice_html",
          "generate_notice_pdf"
        ]
      },
      "idempotency": {
        "key": "noticeId + expectedRevision + approvalContentHash",
        "behavior": "이미 동일 revision/hash가 승인되었으면 같은 승인 결과를 반환한다."
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
