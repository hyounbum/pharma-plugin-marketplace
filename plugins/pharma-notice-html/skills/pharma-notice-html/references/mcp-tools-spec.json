          },
          "preview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resourceUri",
              "mimeType",
              "contentHash",
              "templateHash"
            ],
            "properties": {
              "resourceUri": {
                "type": "string"
              },
              "mimeType": {
                "const": "text/html"
              },
              "contentHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "templateHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      },
      "errorCodes": [
        "NOTICE_NOT_FOUND",
        "DRAFT_NOT_AVAILABLE",
        "VERSION_CONFLICT",
        "TEMPLATE_ASSET_MISSING",
        "HTML_RENDER_FAILED"
      ],
      "userConfirmation": {
        "required": false,
        "condition": "미리보기는 읽기 전용이며 최종 산출물이 아니다."
      },
      "callOrder": {
        "before": [
          "get_notice_draft"
        ],
        "after": [
          "update_notice_items 또는 approve_notice"
        ]
      },
      "idempotency": {
        "key": "noticeId + revision + templateHash + includeExcluded=false",
        "behavior": "동일 초안/템플릿은 캐시된 동일 미리보기를 반환할 수 있다."
